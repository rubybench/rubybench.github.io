- category_benchmarks = ruby_core_benchmarks
.benchmark_page
  .text-center
    %h1 ruby/ruby

    = github_link 'ruby/ruby'

    #graph_metadata{ 'data-unit': 'i/s', 'data-type': 'line' }

    %div
      .category_switcher
        - category_benchmarks.each_key do |category|
          %button.category_switch{ type: 'button', 'data-category': category.downcase }= category

    %ul.nav.nav-pills.benchmark_navbar
      - category_benchmarks.each do |category, benchmarks|
        - benchmarks.each do |benchmark|
          %li.nav-item{ 'data-category': category.downcase }
            %a.nav-link.activate-chart{ href: '#', 'data-id': benchmark }= benchmark

  - graph_data = { 'data-ruby-versions': [], 'data-vm-values': [] }
  - category_benchmarks.each_value do |benchmarks|
    - benchmarks.each do |benchmark|
      .benchmark_graph.highcharts-light{ graph_data, id: benchmark, 'data-name': benchmark }

:javascript
  $(function() {
    var rubies = {};

    // Convert 20250908 or "20250908" to "2025-09-08"
    function formatDate(date) {
      var n = Number(date);

      var year = Math.floor(n / 10000);
      var month = Math.floor(n / 100) % 100;
      var day = n % 100;

      return String(year) + '-' + String(month).padStart(2, '0') + '-' + String(day).padStart(2, '0');
    }

    function plotChart(graphElement) {
      var type = $('#graph_metadata').data('type');
      var unit = $('#graph_metadata').data('unit');
      var name = graphElement.data('name');

      var series = [{
        name: name,
        data: graphElement.data('vm-values')
      }]
      var categories = graphElement.data('ruby-versions');

      Highcharts.setOptions({ lang: { thousandsSep: '' } })
      Highcharts.chart(graphElement.attr('id'), {
        chart: {
          zoomType: 'x',
          animation: false,
          type: type
        },
        title: {
          text: name
        },
        yAxis: {
          min: 0,
          title: {
            text: unit
          }
        },
        xAxis: {
          categories: categories,
          labels: {
            formatter: function() {
              var date = Number(this.value);
              var sha = rubies[date];
              return '<a href="https://github.com/ruby/ruby/commit/' + sha + '">' + formatDate(date) + '</a>';
            }
          }
        },
        tooltip: {
          formatter: function(tooltip) {
            var date = Number(this.category);
            var sha = rubies[date].substring(0, 10);
            var prefix = '<span style="font-size: 10px">' + formatDate(date) + ' revision ' + sha + '</span><br/>' +
              '<span style="color:' + this.color + '">●</span> ' + this.series.name + ': ';
            return prefix + '<b>' + this.y + 's</b>';
          }
        },
        series: series,
        plotOptions: {
          series: {
            animation: false
          }
        }
      });
    };

    // Show only the benchmark tabs of the given category
    function showCategory(category) {
      $('.category_switch').removeClass('active');
      $('.category_switch[data-category="' + category + '"]').addClass('active');
      $('.benchmark_navbar .nav-item[data-category]').hide();
      $('.benchmark_navbar .nav-item[data-category="' + category + '"]').show();
    }

    function activateChart(graphElement) {
      // TODO: show a loading indicator until it receives a response?

      var benchmark = graphElement.attr('id');

      // Keep the category switcher in sync with the benchmark being shown
      var category = $('.activate-chart[data-id="' + benchmark + '"]').closest('.nav-item').data('category');
      if (category) {
        showCategory(category);
      }

      $.get('https://raw.githubusercontent.com/rubybench/rubybench-data/main/ruby/' + benchmark + '/' + benchmark + '.yml').done(function (data) {
        // Show only graphElement and hide everything else
        $('.benchmark_graph').hide();
        graphElement.show();

        var ruby_versions = [];
        var vm_values = [];

        var date_results = jsyaml.load(data);
        for (var date in date_results) {
          var vm_result = date_results[date][0];

          ruby_versions.push(date);
          vm_values.push(vm_result);
        }

        graphElement.data('ruby-versions', ruby_versions);
        graphElement.data('vm-values', vm_values);

        plotChart(graphElement);
      });
    };

    // Switch category and jump to its first benchmark
    showCategory('#{category_benchmarks.keys.first.downcase}');
    $('.category_switch').on('click', function() {
      var category = $(this).data('category');
      showCategory(category);
      var active = $('.benchmark_navbar .nav-link.active');
      if (active.closest('.nav-item').data('category') !== category) {
        $('.benchmark_navbar .nav-item[data-category="' + category + '"] .nav-link').first().trigger('click');
      }
    });

    // Setup navigation
    var navigation = RubyBench.setupBenchmarkNavigation({
      activateChart: activateChart,
      defaultBenchmark: $('.benchmark_graph##{category_benchmarks.values.flatten.first}'),
      enableKeyboardNavigation: true
    });

    // Load rubies first
    $.get('https://raw.githubusercontent.com/rubybench/rubybench-data/master/rubies.yml').done(function (data) {
      rubies = jsyaml.load(data);
      navigation.handleHashNavigation();
    });
  });

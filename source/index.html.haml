%h2.text-center ruby-bench

.benchmarks-wrapper
  = partial 'dashboard'

%table.benchmarks-table.table.table-striped
  %thead
    %tr
      %th Category
      %th Benchmarks
  %tbody
    :ruby
      benchmarks = ruby_bench_benchmarks
      category_benchmarks = {
        'Headline Benchmarks' => benchmarks.filter_map { |name, benchmark| name if benchmark.fetch('category', 'other') == 'headline' },
        'Other Benchmarks' => benchmarks.filter_map { |name, benchmark| name if benchmark.fetch('category', 'other') == 'other' },
        'MicroBenchmarks' => benchmarks.filter_map { |name, benchmark| name if benchmark.fetch('category', 'other') == 'micro' },
      }
    - category_benchmarks.each do |category, benchmarks|
      %tr
        %td= category
        %td.margined-links
          - benchmarks.each do |benchmark|
            = link_to benchmark, "/benchmarks/ruby-bench.html##{benchmark}"

%h2.text-center ruby-bench (Ractor)
%h4.text-center Parallel execution benchmarks

%table.large-margin.benchmarks-table.table.table-striped
  %thead
    %tr
      %th Category
      %th Benchmarks
  %tbody
    :ruby
      benchmarks = ruby_bench_benchmarks
      all_ractor_benchmarks = benchmarks.select { |name, meta| meta['ractor'] }
    %tr
      %td Ractor
      %td.margined-links
        - all_ractor_benchmarks.each do |benchmark, meta|
          = link_to benchmark, "/benchmarks/ractor.html##{benchmark.gsub('/', '_')}"

%h2.text-center ruby/ruby
%h4.text-center Ruby core benchmarks

%table.large-margin.benchmarks-table.table.table-striped
  %thead
    %tr
      %th Category
      %th Benchmarks
  %tbody
    - ruby_core_benchmarks.each do |category, benchmarks|
      %tr
        %td= category
        %td.margined-links
          - benchmarks.each do |benchmark|
            = link_to benchmark.split('_', 2).last.gsub(/_/, ' '), "/benchmarks/ruby.html##{benchmark}"
